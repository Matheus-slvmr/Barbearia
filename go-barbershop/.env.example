# Barbershop API - Environment Configuration

# Server
SERVER_PORT=8080

# Database
# Se deixar vazio, usa JSON em arquivo
# DATABASE_URL=

# WhatsApp (futura integração)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=

# CORS
ALLOWED_ORIGINS=*
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Environment
ENV=development
